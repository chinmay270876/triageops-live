        <mxCell id="lab09-c5" value="config.py  Settings&lt;br&gt;reads env / .env&lt;br&gt;ai_api_key: SecretStr&lt;br&gt;no key = no start" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="lab09-1">
          <mxGeometry x="680" y="330" width="600" height="360" as="geometry" />
