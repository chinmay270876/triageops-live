        <mxCell id="lab04-c13" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;sketch=1;curveFitting=1;jiggle=2;html=1;strokeWidth=4;endArrow=classic;endSize=14;fontFamily=Comic Sans MS;fontSize=22;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="lab04-1" source="lab04-c6" target="lab04-c7">
          <mxGeometry relative="1" as="geometry" />
