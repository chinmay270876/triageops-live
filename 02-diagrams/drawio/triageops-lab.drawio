        <mxCell id="lab11-c15" value="Concept&lt;br&gt;Build once, run anywhere. Config and secrets come in at run time.&lt;br&gt;Never tag latest: always know which version runs." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=16;spacingRight=12;" vertex="1" parent="lab11-1">
