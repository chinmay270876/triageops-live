        <mxCell id="lab03-c13" value="creates" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;sketch=1;curveFitting=1;jiggle=2;html=1;strokeWidth=4;endArrow=classic;endSize=14;fontFamily=Comic Sans MS;fontSize=22;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;" edge="1" parent="lab03-1" source="lab03-c3" target="lab03-c5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lab03-c14" value="Concept&lt;br&gt;A subnet is public only because its route table sends 0.0.0.0/0 to an internet gateway.&lt;br&gt;The elb tag tells EKS where to place the public load balancer." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=16;spacingRight=12;" vertex="1" parent="lab03-1">
          <mxGeometry x="60" y="1200" width="1130" height="330" as="geometry" />
        </mxCell>
        <mxCell id="lab03-c15" value="Interview Question&lt;br&gt;Why two subnets in two Availability Zones?&lt;br&gt;What breaks if the elb tag is missing?" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;spacingLeft=16;spacingRight=12;" vertex="1" parent="lab03-1">
          <mxGeometry x="1230" y="1200" width="1130" height="330" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
