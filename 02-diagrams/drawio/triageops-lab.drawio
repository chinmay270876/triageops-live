  <diagram id="lab10" name="L10 How the Files Connect">
    <mxGraphModel dx="2400" dy="1700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1700" math="0" shadow="0">
      <root>
        <mxCell id="lab10-0" />
        <mxCell id="lab10-1" parent="lab10-0" />
        <mxCell id="lab10-c1" value="How the Files Connect: One Complaint Through the Code" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Comic Sans MS;fontSize=40;fontStyle=1;" vertex="1" parent="lab10-1">
          <mxGeometry x="40" y="20" width="2320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="lab10-c2" value="curl /&lt;br&gt;food app" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="lab10-1">
