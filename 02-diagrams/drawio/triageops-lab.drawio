        <mxCell id="lab02-c5" value="OPERATE" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="lab02-1">
