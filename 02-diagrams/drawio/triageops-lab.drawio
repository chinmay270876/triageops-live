        </mxCell>
        <mxCell id="lab02-c6" value="00 Laptop ready&lt;br&gt;01 VPC&lt;br&gt;02 IAM role, key, SG, EC2&lt;br&gt;03 PuTTY + role check&lt;br&gt;04 Install tools&lt;br&gt;05 Start EKS&lt;br&gt;(20 min, background)&lt;br&gt;06 GitHub repo + token" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;spacingLeft=20;" vertex="1" parent="lab02-1">
          <mxGeometry x="60" y="300" width="540" height="700" as="geometry" />
        </mxCell>
        <mxCell id="lab02-c7" value="07 Gate 1 CONTRACT&lt;br&gt;models.py&lt;br&gt;&lt;br&gt;08 Gate 2 ASYNC&lt;br&gt;ai_stub, ai_client, triage&lt;br&gt;&lt;br&gt;09 Gate 3 SERVICE&lt;br&gt;config, logs, healthz&lt;br&gt;&lt;br&gt;Pull Request 1" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;spacingLeft=20;" vertex="1" parent="lab02-1">
