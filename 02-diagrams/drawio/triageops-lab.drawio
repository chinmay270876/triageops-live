        <mxCell id="lab04-c15" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;sketch=1;curveFitting=1;jiggle=2;html=1;strokeWidth=4;endArrow=classic;endSize=14;fontFamily=Comic Sans MS;fontSize=22;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.8;" edge="1" parent="lab04-1" source="lab04-c5" target="lab04-c8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lab04-c16" value="Concept&lt;br&gt;Humans log in with users. Machines get roles.&lt;br&gt;No access keys on the server, ever. Never leave the security group on default." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=16;spacingRight=12;" vertex="1" parent="lab04-1">
