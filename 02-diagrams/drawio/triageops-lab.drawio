        <mxCell id="lab03-c8" value="Public subnet B&lt;br&gt;10.0.2.0/24  ap-south-1b&lt;br&gt;tag kubernetes.io/role/elb=1&lt;br&gt;auto-assign public IP" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="lab03-1">
