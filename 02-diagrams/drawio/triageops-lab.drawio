  <diagram id="lab05" name="L05 Part 04-05 Tools and EKS">
    <mxGraphModel dx="2400" dy="1700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1700" math="0" shadow="0">
      <root>
        <mxCell id="lab05-0" />
        <mxCell id="lab05-1" parent="lab05-0" />
        <mxCell id="lab05-c1" value="Part 04-05: Tools and the EKS Cluster" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Comic Sans MS;fontSize=40;fontStyle=1;" vertex="1" parent="lab05-1">
          <mxGeometry x="40" y="20" width="2320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="lab05-c2" value="EC2 workstation&lt;br&gt;&lt;br&gt;docker, git&lt;br&gt;python3.11&lt;br&gt;kubectl 1.34&lt;br&gt;eksctl" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="lab05-1">
          <mxGeometry x="60" y="160" width="520" height="480" as="geometry" />
        </mxCell>
        <mxCell id="lab05-c3" value="cluster.yaml&lt;br&gt;name triageops-eks&lt;br&gt;version 1.34&lt;br&gt;subnets A + B&lt;br&gt;2 x t3.medium" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="lab05-1">
          <mxGeometry x="660" y="160" width="540" height="300" as="geometry" />
        </mxCell>
        <mxCell id="lab05-c4" value="nohup eksctl create&lt;br&gt;cluster -f cluster.yaml&lt;br&gt;-&gt; eks-create.log" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="lab05-1">
          <mxGeometry x="660" y="520" width="540" height="200" as="geometry" />
        </mxCell>
        <mxCell id="lab05-c5" value="CloudFormation stack&lt;br&gt;eksctl-triageops-eks-cluster" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="lab05-1">
          <mxGeometry x="1280" y="160" width="560" height="200" as="geometry" />
        </mxCell>
        <mxCell id="lab05-c6" value="CloudFormation stack&lt;br&gt;...-nodegroup-triage-nodes" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="lab05-1">
          <mxGeometry x="1280" y="460" width="560" height="200" as="geometry" />
        </mxCell>
        <mxCell id="lab05-c7" value="Control plane&lt;br&gt;(AWS runs it)" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="lab05-1">
          <mxGeometry x="1920" y="160" width="420" height="200" as="geometry" />
        </mxCell>
        <mxCell id="lab05-c8" value="2 worker nodes&lt;br&gt;(our pods run here)" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="lab05-1">
          <mxGeometry x="1920" y="460" width="420" height="200" as="geometry" />
        </mxCell>
        <mxCell id="lab05-c9" value="~/.kube/config  -&gt;  kubectl get nodes  =  2 Ready" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="lab05-1">
          <mxGeometry x="1280" y="760" width="1060" height="120" as="geometry" />
        </mxCell>
        <mxCell id="lab05-c10" value="Before eksctl, always:&lt;br&gt;1. subnet IDs by Name tag (never old IDs)&lt;br&gt;2. no leftover eksctl- stacks&lt;br&gt;3. stopped half way? wait for the stack, eksctl create nodegroup,&lt;br&gt;eksctl utils write-kubeconfig" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#F8CECC;strokeColor=#B85450;align=left;spacingLeft=20;" vertex="1" parent="lab05-1">
          <mxGeometry x="60" y="760" width="1140" height="300" as="geometry" />
        </mxCell>
        <mxCell id="lab05-c11" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;sketch=1;curveFitting=1;jiggle=2;html=1;strokeWidth=4;endArrow=classic;endSize=14;fontFamily=Comic Sans MS;fontSize=22;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="lab05-1" source="lab05-c2" target="lab05-c3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lab05-c12" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;sketch=1;curveFitting=1;jiggle=2;html=1;strokeWidth=4;endArrow=classic;endSize=14;fontFamily=Comic Sans MS;fontSize=22;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="lab05-1" source="lab05-c3" target="lab05-c4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lab05-c13" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;sketch=1;curveFitting=1;jiggle=2;html=1;strokeWidth=4;endArrow=classic;endSize=14;fontFamily=Comic Sans MS;fontSize=22;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;" edge="1" parent="lab05-1" source="lab05-c4" target="lab05-c5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lab05-c14" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;sketch=1;curveFitting=1;jiggle=2;html=1;strokeWidth=4;endArrow=classic;endSize=14;fontFamily=Comic Sans MS;fontSize=22;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="lab05-1" source="lab05-c5" target="lab05-c6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lab05-c15" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;sketch=1;curveFitting=1;jiggle=2;html=1;strokeWidth=4;endArrow=classic;endSize=14;fontFamily=Comic Sans MS;fontSize=22;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="lab05-1" source="lab05-c5" target="lab05-c7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lab05-c16" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;sketch=1;curveFitting=1;jiggle=2;html=1;strokeWidth=4;endArrow=classic;endSize=14;fontFamily=Comic Sans MS;fontSize=22;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="lab05-1" source="lab05-c6" target="lab05-c8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lab05-c17" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;sketch=1;curveFitting=1;jiggle=2;html=1;strokeWidth=4;endArrow=classic;endSize=14;fontFamily=Comic Sans MS;fontSize=22;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.8;entryY=0;" edge="1" parent="lab05-1" source="lab05-c8" target="lab05-c9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lab05-c18" value="Concept&lt;br&gt;eksctl writes CloudFormation for us. Control plane = the brain AWS manages.&lt;br&gt;Node group = our EC2 machines where pods run." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=16;spacingRight=12;" vertex="1" parent="lab05-1">
          <mxGeometry x="60" y="1150" width="1130" height="330" as="geometry" />
        </mxCell>
        <mxCell id="lab05-c19" value="Interview Question&lt;br&gt;kubectl 1.37 and cluster 1.34: what is the rule?&lt;br&gt;What does nohup protect you from?" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;spacingLeft=16;spacingRight=12;" vertex="1" parent="lab05-1">
          <mxGeometry x="1230" y="1150" width="1130" height="330" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="lab06" name="L06 Part 06 GitHub Workflow">
    <mxGraphModel dx="2400" dy="1700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1700" math="0" shadow="0">
      <root>
        <mxCell id="lab06-0" />
        <mxCell id="lab06-1" parent="lab06-0" />
        <mxCell id="lab06-c1" value="Part 06: GitHub Workflow (one branch per part)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Comic Sans MS;fontSize=40;fontStyle=1;" vertex="1" parent="lab06-1">
          <mxGeometry x="40" y="20" width="2320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="lab06-c2" value="main" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="lab06-1">
          <mxGeometry x="60" y="180" width="360" height="160" as="geometry" />
