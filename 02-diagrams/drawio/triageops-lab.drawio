        <mxCell id="lab09-c7" value="JSON logs&lt;br&gt;request_id&lt;br&gt;duration_ms&lt;br&gt;complaint_length&lt;br&gt;NO complaint text" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="lab09-1">
          <mxGeometry x="1360" y="540" width="500" height="390" as="geometry" />
        </mxCell>
        <mxCell id="lab09-c8" value="Log line:&lt;br&gt;triage_completed&lt;br&gt;request_id a843...&lt;br&gt;decided_by ai&lt;br&gt;duration_ms 1025&lt;br&gt;&lt;br&gt;phone number: 0&lt;br&gt;API key: 0" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#D5E8D4;strokeColor=#82B366;align=left;spacingLeft=16;" vertex="1" parent="lab09-1">
