        <mxCell id="lab09-c14" value="Concept&lt;br&gt;Same code, different environment.&lt;br&gt;The secret lives outside the code, outside Git, outside the image, outside the logs." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=16;spacingRight=12;" vertex="1" parent="lab09-1">
