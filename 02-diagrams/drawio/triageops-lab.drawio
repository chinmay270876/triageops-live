        <mxCell id="lab08-c1" value="Part 08: Gate 2 ASYNC in the Lab (10 complaints, AI = 1 second each)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Comic Sans MS;fontSize=40;fontStyle=1;" vertex="1" parent="lab08-1">
          <mxGeometry x="40" y="20" width="2320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="lab08-c2" value="sync&lt;br&gt;httpx.Client, one by one" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="lab08-1">
