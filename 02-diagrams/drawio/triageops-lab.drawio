        <mxCell id="lab04-c14" value="who am I?" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;sketch=1;curveFitting=1;jiggle=2;html=1;strokeWidth=4;endArrow=classic;endSize=14;fontFamily=Comic Sans MS;fontSize=22;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;" edge="1" parent="lab04-1" source="lab04-c5" target="lab04-c7">
