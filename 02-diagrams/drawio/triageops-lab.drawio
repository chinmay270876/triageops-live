        <mxCell id="lab02-c8" value="10 Docker image + ECR&lt;br&gt;&lt;br&gt;11 Deploy to EKS&lt;br&gt;ConfigMap, Secret,&lt;br&gt;Deployments, Services&lt;br&gt;&lt;br&gt;12 Web page v1.3.0&lt;br&gt;rolling update&lt;br&gt;+ rollback" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#D5E8D4;strokeColor=#82B366;align=left;spacingLeft=20;" vertex="1" parent="lab02-1">
          <mxGeometry x="1220" y="300" width="540" height="700" as="geometry" />
        </mxCell>
        <mxCell id="lab02-c9" value="13 Break it,&lt;br&gt;diagnose&lt;br&gt;(6 failures)&lt;br&gt;&lt;br&gt;14 Clean up&lt;br&gt;&lt;br&gt;15 Troubleshooting" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#F8CECC;strokeColor=#B85450;align=left;spacingLeft=20;" vertex="1" parent="lab02-1">
          <mxGeometry x="1800" y="300" width="540" height="700" as="geometry" />
        </mxCell>
        <mxCell id="lab02-c10" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;sketch=1;curveFitting=1;jiggle=2;html=1;strokeWidth=4;endArrow=classic;endSize=14;fontFamily=Comic Sans MS;fontSize=22;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="lab02-1" source="lab02-c6" target="lab02-c7">
