        <mxCell id="lab09-c6" value="main.py&lt;br&gt;GET /healthz&lt;br&gt;POST /triage&lt;br&gt;X-Request-ID" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="lab09-1">
          <mxGeometry x="1360" y="170" width="500" height="300" as="geometry" />
