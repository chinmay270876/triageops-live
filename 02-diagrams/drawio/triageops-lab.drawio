        <mxCell id="lab02-c12" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;sketch=1;curveFitting=1;jiggle=2;html=1;strokeWidth=4;endArrow=classic;endSize=14;fontFamily=Comic Sans MS;fontSize=22;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="lab02-1" source="lab02-c8" target="lab02-c9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lab02-c13" value="Golden rule: one branch per part  -&gt;  Pull Request  -&gt;  Merge  -&gt;  back to main  -&gt;  next branch" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="lab02-1">
          <mxGeometry x="60" y="1060" width="2280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="lab02-c14" value="Concept&lt;br&gt;EKS takes about 20 minutes. We start it early in the background (nohup)&lt;br&gt;and write the code while AWS builds the cluster." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=16;spacingRight=12;" vertex="1" parent="lab02-1">
