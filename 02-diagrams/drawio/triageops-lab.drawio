          <mxGeometry x="1220" y="180" width="520" height="420" as="geometry" />
        </mxCell>
        <mxCell id="lab14-c5" value="4. Done&lt;br&gt;v1.3.0&lt;br&gt;v1.3.0&lt;br&gt;&lt;br&gt;maxUnavailable 0:&lt;br&gt;never below 2" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="lab14-1">
          <mxGeometry x="1800" y="180" width="520" height="420" as="geometry" />
        </mxCell>
        <mxCell id="lab14-c6" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;sketch=1;curveFitting=1;jiggle=2;html=1;strokeWidth=4;endArrow=classic;endSize=14;fontFamily=Comic Sans MS;fontSize=22;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="lab14-1" source="lab14-c2" target="lab14-c3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lab14-c7" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;sketch=1;curveFitting=1;jiggle=2;html=1;strokeWidth=4;endArrow=classic;endSize=14;fontFamily=Comic Sans MS;fontSize=22;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="lab14-1" source="lab14-c3" target="lab14-c4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lab14-c8" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;sketch=1;curveFitting=1;jiggle=2;html=1;strokeWidth=4;endArrow=classic;endSize=14;fontFamily=Comic Sans MS;fontSize=22;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="lab14-1" source="lab14-c4" target="lab14-c5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lab14-c9" value="Second PuTTY window: curl /healthz every second&lt;br&gt;1.2.0 ... 1.2.0 ... 1.3.0 ... 1.3.0   and zero FAILED" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="lab14-1">
          <mxGeometry x="60" y="680" width="1130" height="220" as="geometry" />
        </mxCell>
        <mxCell id="lab14-c10" value="kubectl rollout undo&lt;br&gt;back to 1.2.0 in seconds&lt;br&gt;then apply 1.3.0 again" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="lab14-1">
          <mxGeometry x="1230" y="680" width="1110" height="220" as="geometry" />
        </mxCell>
        <mxCell id="lab14-c11" value="New in 1.3.0: complaint web page at  /   (app/static/index.html + app/web.py)" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="lab14-1">
          <mxGeometry x="60" y="960" width="2280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="lab14-c12" value="Concept&lt;br&gt;New tag for every release, never overwrite. Readiness probe + maxUnavailable 0&lt;br&gt;= customers never see a half-started pod." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=16;spacingRight=12;" vertex="1" parent="lab14-1">
          <mxGeometry x="60" y="1160" width="1130" height="330" as="geometry" />
        </mxCell>
        <mxCell id="lab14-c13" value="Interview Question&lt;br&gt;Why must 1.3.0 be a new tag and not overwrite 1.2.0?&lt;br&gt;How do you prove there was no downtime?" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;spacingLeft=16;spacingRight=12;" vertex="1" parent="lab14-1">
          <mxGeometry x="1230" y="1160" width="1130" height="330" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="lab15" name="L15 Part 13 Break It">
    <mxGraphModel dx="2400" dy="1700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1700" math="0" shadow="0">
      <root>
        <mxCell id="lab15-0" />
        <mxCell id="lab15-1" parent="lab15-0" />
        <mxCell id="lab15-c1" value="Part 13: Break It and Diagnose" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Comic Sans MS;fontSize=40;fontStyle=1;" vertex="1" parent="lab15-1">
          <mxGeometry x="40" y="20" width="2320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="lab15-c2" value="1. Secret missing&lt;br&gt;CrashLoopBackOff&lt;br&gt;kubectl logs:&lt;br&gt;Field required&lt;br&gt;fix: rollout undo" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="lab15-1">
          <mxGeometry x="60" y="160" width="740" height="400" as="geometry" />
        </mxCell>
        <mxCell id="lab15-c3" value="2. Wrong key&lt;br&gt;AI returned 401&lt;br&gt;our JSON log&lt;br&gt;&lt;br&gt;fix: Secret + restart" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="lab15-1">
          <mxGeometry x="830" y="160" width="740" height="400" as="geometry" />
        </mxCell>
        <mxCell id="lab15-c4" value="3. Garbage answer&lt;br&gt;invalid AI answer&lt;br&gt;check 2 caught it&lt;br&gt;&lt;br&gt;fix: AI side" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="lab15-1">
          <mxGeometry x="1600" y="160" width="740" height="400" as="geometry" />
        </mxCell>
        <mxCell id="lab15-c5" value="4. Slow AI&lt;br&gt;AI timed out (3 s)&lt;br&gt;duration_ms&lt;br&gt;&lt;br&gt;fix: AI side / timeout" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="lab15-1">
          <mxGeometry x="60" y="600" width="740" height="400" as="geometry" />
        </mxCell>
        <mxCell id="lab15-c6" value="5. AI down&lt;br&gt;AI unavailable&lt;br&gt;kubectl get pods&lt;br&gt;&lt;br&gt;fix: scale up" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="lab15-1">
          <mxGeometry x="830" y="600" width="740" height="400" as="geometry" />
        </mxCell>
        <mxCell id="lab15-c7" value="6. Bad probe&lt;br&gt;0/1 READY, stuck&lt;br&gt;kubectl describe&lt;br&gt;&lt;br&gt;fix: rollout undo" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="lab15-1">
          <mxGeometry x="1600" y="600" width="740" height="400" as="geometry" />
        </mxCell>
        <mxCell id="lab15-c8" value="Breaks 1 and 6: the broken version never got a customer.   Breaks 2 to 5: the service never crashed." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="lab15-1">
          <mxGeometry x="60" y="1050" width="2280" height="130" as="geometry" />
        </mxCell>
        <mxCell id="lab15-c9" value="Concept&lt;br&gt;Four commands solve most problems:&lt;br&gt;kubectl get pods, describe, logs, rollout status / undo." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=16;spacingRight=12;" vertex="1" parent="lab15-1">
          <mxGeometry x="60" y="1250" width="1130" height="330" as="geometry" />
        </mxCell>
        <mxCell id="lab15-c10" value="Interview Question&lt;br&gt;A pod is in CrashLoopBackOff. What are your first two commands?" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;spacingLeft=16;spacingRight=12;" vertex="1" parent="lab15-1">
          <mxGeometry x="1230" y="1250" width="1130" height="330" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="lab16" name="L16 Part 14 Clean Up">
    <mxGraphModel dx="2400" dy="1700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1700" math="0" shadow="0">
      <root>
        <mxCell id="lab16-0" />
        <mxCell id="lab16-1" parent="lab16-0" />
        <mxCell id="lab16-c1" value="Part 14: Clean Up (the order matters)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Comic Sans MS;fontSize=40;fontStyle=1;" vertex="1" parent="lab16-1">
          <mxGeometry x="40" y="20" width="2320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="lab16-c2" value="1. kubectl delete&lt;br&gt;namespace&lt;br&gt;(LB goes too)" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="lab16-1">
          <mxGeometry x="60" y="180" width="520" height="280" as="geometry" />
        </mxCell>
        <mxCell id="lab16-c3" value="2. eksctl delete&lt;br&gt;cluster --wait" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="lab16-1">
          <mxGeometry x="640" y="180" width="520" height="280" as="geometry" />
        </mxCell>
        <mxCell id="lab16-c4" value="3. Delete ECR&lt;br&gt;repository" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="lab16-1">
          <mxGeometry x="1220" y="180" width="520" height="280" as="geometry" />
        </mxCell>
        <mxCell id="lab16-c5" value="4. Terminate EC2" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="lab16-1">
          <mxGeometry x="1800" y="180" width="520" height="280" as="geometry" />
        </mxCell>
        <mxCell id="lab16-c6" value="8. Revoke the&lt;br&gt;GitHub token" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="lab16-1">
          <mxGeometry x="60" y="560" width="520" height="280" as="geometry" />
        </mxCell>
        <mxCell id="lab16-c7" value="7. VPC: IGW,&lt;br&gt;subnets, RT, VPC" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="lab16-1">
          <mxGeometry x="640" y="560" width="520" height="280" as="geometry" />
        </mxCell>
        <mxCell id="lab16-c8" value="6. IAM role +&lt;br&gt;instance profile" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="lab16-1">
          <mxGeometry x="1220" y="560" width="520" height="280" as="geometry" />
        </mxCell>
        <mxCell id="lab16-c9" value="5. Key pair +&lt;br&gt;security group" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="lab16-1">
          <mxGeometry x="1800" y="560" width="520" height="280" as="geometry" />
        </mxCell>
        <mxCell id="lab16-c10" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;sketch=1;curveFitting=1;jiggle=2;html=1;strokeWidth=4;endArrow=classic;endSize=14;fontFamily=Comic Sans MS;fontSize=22;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="lab16-1" source="lab16-c2" target="lab16-c3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lab16-c11" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;sketch=1;curveFitting=1;jiggle=2;html=1;strokeWidth=4;endArrow=classic;endSize=14;fontFamily=Comic Sans MS;fontSize=22;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="lab16-1" source="lab16-c3" target="lab16-c4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lab16-c12" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;sketch=1;curveFitting=1;jiggle=2;html=1;strokeWidth=4;endArrow=classic;endSize=14;fontFamily=Comic Sans MS;fontSize=22;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="lab16-1" source="lab16-c4" target="lab16-c5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lab16-c13" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;sketch=1;curveFitting=1;jiggle=2;html=1;strokeWidth=4;endArrow=classic;endSize=14;fontFamily=Comic Sans MS;fontSize=22;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="lab16-1" source="lab16-c5" target="lab16-c9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lab16-c14" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;sketch=1;curveFitting=1;jiggle=2;html=1;strokeWidth=4;endArrow=classic;endSize=14;fontFamily=Comic Sans MS;fontSize=22;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="lab16-1" source="lab16-c9" target="lab16-c8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lab16-c15" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;sketch=1;curveFitting=1;jiggle=2;html=1;strokeWidth=4;endArrow=classic;endSize=14;fontFamily=Comic Sans MS;fontSize=22;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="lab16-1" source="lab16-c8" target="lab16-c7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lab16-c16" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;sketch=1;curveFitting=1;jiggle=2;html=1;strokeWidth=4;endArrow=classic;endSize=14;fontFamily=Comic Sans MS;fontSize=22;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="lab16-1" source="lab16-c7" target="lab16-c6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lab16-c17" value="Delete the cluster first and the load balancer is left behind:&lt;br&gt;it keeps costing money and blocks the VPC delete." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="lab16-1">
          <mxGeometry x="60" y="940" width="2280" height="180" as="geometry" />
        </mxCell>
        <mxCell id="lab16-c18" value="Concept&lt;br&gt;Delete from the outside in: what uses a thing goes before the thing.&lt;br&gt;The VPC goes last because everything lives inside it." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=16;spacingRight=12;" vertex="1" parent="lab16-1">
          <mxGeometry x="60" y="1200" width="1130" height="330" as="geometry" />
        </mxCell>
        <mxCell id="lab16-c19" value="Interview Question&lt;br&gt;Why delete the namespace before the cluster?&lt;br&gt;Why does the VPC go last?" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;spacingLeft=16;spacingRight=12;" vertex="1" parent="lab16-1">
          <mxGeometry x="1230" y="1200" width="1130" height="330" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
