          <mxGeometry x="1900" y="810" width="440" height="220" as="geometry" />
        </mxCell>
        <mxCell id="lab08-c15" value="Concept&lt;br&gt;Async does not make the AI faster. It stops our service from sitting idle while it waits.&lt;br&gt;The timeout means a slow AI never holds a customer forever." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=16;spacingRight=12;" vertex="1" parent="lab08-1">
          <mxGeometry x="60" y="1110" width="1130" height="330" as="geometry" />
        </mxCell>
        <mxCell id="lab08-c16" value="Interview Question&lt;br&gt;Your code says async def but it is still slow. Why?&lt;br&gt;What happens to a complaint when the AI times out?" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;spacingLeft=16;spacingRight=12;" vertex="1" parent="lab08-1">
          <mxGeometry x="1230" y="1110" width="1130" height="330" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
