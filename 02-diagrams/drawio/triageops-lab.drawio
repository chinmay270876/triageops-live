        <mxCell id="lab10-c3" value="main.py&lt;br&gt;POST /triage&lt;br&gt;front door" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="lab10-1">
          <mxGeometry x="460" y="180" width="440" height="240" as="geometry" />
        </mxCell>
        <mxCell id="lab10-c4" value="triage.py&lt;br&gt;ai_triage()&lt;br&gt;the decision" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="lab10-1">
          <mxGeometry x="980" y="180" width="440" height="240" as="geometry" />
        </mxCell>
        <mxCell id="lab10-c5" value="ai_client.py&lt;br&gt;ask_ai()&lt;br&gt;the phone call" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="lab10-1">
          <mxGeometry x="1500" y="180" width="420" height="240" as="geometry" />
        </mxCell>
        <mxCell id="lab10-c6" value="ai_stub&lt;br&gt;/classify&lt;br&gt;the AI" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="lab10-1">
          <mxGeometry x="2000" y="180" width="340" height="240" as="geometry" />
        </mxCell>
        <mxCell id="lab10-c7" value="models.py&lt;br&gt;ComplaintIn = check 1&lt;br&gt;TriageResult = check 2&lt;br&gt;TriageResponse = answer" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="lab10-1">
          <mxGeometry x="460" y="560" width="960" height="260" as="geometry" />
        </mxCell>
        <mxCell id="lab10-c8" value="config.py&lt;br&gt;url, timeout, key" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="lab10-1">
          <mxGeometry x="1500" y="560" width="420" height="260" as="geometry" />
        </mxCell>
        <mxCell id="lab10-c9" value="logging_config.py&lt;br&gt;JSON log line" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="lab10-1">
          <mxGeometry x="60" y="560" width="320" height="260" as="geometry" />
        </mxCell>
        <mxCell id="lab10-c10" value="1" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;sketch=1;curveFitting=1;jiggle=2;html=1;strokeWidth=4;endArrow=classic;endSize=14;fontFamily=Comic Sans MS;fontSize=22;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="lab10-1" source="lab10-c2" target="lab10-c3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lab10-c11" value="2" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;sketch=1;curveFitting=1;jiggle=2;html=1;strokeWidth=4;endArrow=classic;endSize=14;fontFamily=Comic Sans MS;fontSize=22;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="lab10-1" source="lab10-c3" target="lab10-c4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lab10-c12" value="3" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;sketch=1;curveFitting=1;jiggle=2;html=1;strokeWidth=4;endArrow=classic;endSize=14;fontFamily=Comic Sans MS;fontSize=22;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="lab10-1" source="lab10-c4" target="lab10-c5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lab10-c13" value="4" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;sketch=1;curveFitting=1;jiggle=2;html=1;strokeWidth=4;endArrow=classic;endSize=14;fontFamily=Comic Sans MS;fontSize=22;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="lab10-1" source="lab10-c5" target="lab10-c6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lab10-c14" value="check 1" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;sketch=1;curveFitting=1;jiggle=2;html=1;strokeWidth=4;endArrow=classic;endSize=14;fontFamily=Comic Sans MS;fontSize=22;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=1;entryX=0.1;entryY=0;" edge="1" parent="lab10-1" source="lab10-c3" target="lab10-c7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lab10-c15" value="check 2" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;sketch=1;curveFitting=1;jiggle=2;html=1;strokeWidth=4;endArrow=classic;endSize=14;fontFamily=Comic Sans MS;fontSize=22;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.7;entryY=0;" edge="1" parent="lab10-1" source="lab10-c4" target="lab10-c7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lab10-c16" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;sketch=1;curveFitting=1;jiggle=2;html=1;strokeWidth=4;endArrow=classic;endSize=14;fontFamily=Comic Sans MS;fontSize=22;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="lab10-1" source="lab10-c8" target="lab10-c5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lab10-c17" value="5 log" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;sketch=1;curveFitting=1;jiggle=2;html=1;strokeWidth=4;endArrow=classic;endSize=14;fontFamily=Comic Sans MS;fontSize=22;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.8;entryX=0.5;entryY=0;" edge="1" parent="lab10-1" source="lab10-c3" target="lab10-c9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lab10-c18" value="Return path: AI answer -&gt; check 2 -&gt; TriageResponse (or Human Review) -&gt; log line -&gt; JSON to the caller with X-Request-ID" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="lab10-1">
          <mxGeometry x="60" y="900" width="2280" height="140" as="geometry" />
        </mxCell>
        <mxCell id="lab10-c19" value="Concept&lt;br&gt;Each file has one job. models = the rules, triage = the decision, ai_client = the phone call,&lt;br&gt;config = the settings, main = the front door." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=16;spacingRight=12;" vertex="1" parent="lab10-1">
          <mxGeometry x="60" y="1120" width="1130" height="330" as="geometry" />
        </mxCell>
        <mxCell id="lab10-c20" value="Interview Question&lt;br&gt;The AI is down. Which file decides what the customer gets back?" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;spacingLeft=16;spacingRight=12;" vertex="1" parent="lab10-1">
          <mxGeometry x="1230" y="1120" width="1130" height="330" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="lab11" name="L11 Part 10 Docker and ECR">
    <mxGraphModel dx="2400" dy="1700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1700" math="0" shadow="0">
      <root>
        <mxCell id="lab11-0" />
        <mxCell id="lab11-1" parent="lab11-0" />
        <mxCell id="lab11-c1" value="Part 10: Gate 4 SHIP (1) Docker Image and Amazon ECR" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Comic Sans MS;fontSize=40;fontStyle=1;" vertex="1" parent="lab11-1">
          <mxGeometry x="40" y="20" width="2320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="lab11-c2" value="Repo&lt;br&gt;app/  ai_stub/&lt;br&gt;requirements.txt&lt;br&gt;.env  .venv" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="lab11-1">
          <mxGeometry x="60" y="170" width="480" height="400" as="geometry" />
        </mxCell>
        <mxCell id="lab11-c3" value=".dockerignore&lt;br&gt;.env .venv .git&lt;br&gt;never enter the build" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="lab11-1">
          <mxGeometry x="60" y="650" width="480" height="250" as="geometry" />
        </mxCell>
        <mxCell id="lab11-c4" value="Dockerfile&lt;br&gt;python:3.11-slim&lt;br&gt;useradd appuser (10001)&lt;br&gt;COPY requirements.txt&lt;br&gt;pip install (cached)&lt;br&gt;COPY app, ai_stub&lt;br&gt;USER appuser&lt;br&gt;HEALTHCHECK /healthz&lt;br&gt;CMD uvicorn app.main" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=20;" vertex="1" parent="lab11-1">
          <mxGeometry x="620" y="170" width="720" height="730" as="geometry" />
        </mxCell>
        <mxCell id="lab11-c5" value="Image&lt;br&gt;triageops:1.2.0" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="lab11-1">
          <mxGeometry x="1420" y="170" width="440" height="260" as="geometry" />
        </mxCell>
        <mxCell id="lab11-c6" value="Same image,&lt;br&gt;two commands:&lt;br&gt;triage (8000)&lt;br&gt;ai-stub (9000)&lt;br&gt;network triage-net" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="lab11-1">
          <mxGeometry x="1420" y="510" width="440" height="390" as="geometry" />
        </mxCell>
        <mxCell id="lab11-c7" value="Amazon ECR&lt;br&gt;scanOnPush&lt;br&gt;tag 1.2.0" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="lab11-1">
          <mxGeometry x="1940" y="170" width="400" height="260" as="geometry" />
        </mxCell>
        <mxCell id="lab11-c8" value="-e AI_API_URL&lt;br&gt;-e AI_API_KEY&lt;br&gt;at run time,&lt;br&gt;not in the image" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="lab11-1">
          <mxGeometry x="1940" y="510" width="400" height="390" as="geometry" />
        </mxCell>
        <mxCell id="lab11-c9" value="docker build" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;sketch=1;curveFitting=1;jiggle=2;html=1;strokeWidth=4;endArrow=classic;endSize=14;fontFamily=Comic Sans MS;fontSize=22;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="lab11-1" source="lab11-c2" target="lab11-c4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lab11-c10" value="blocks" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;sketch=1;curveFitting=1;jiggle=2;html=1;strokeWidth=4;endArrow=classic;endSize=14;fontFamily=Comic Sans MS;fontSize=22;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;" edge="1" parent="lab11-1" source="lab11-c3" target="lab11-c4">
          <mxGeometry relative="1" as="geometry" />
