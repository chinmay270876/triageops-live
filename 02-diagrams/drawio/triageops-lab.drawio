        <mxCell id="lab03-c11" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;sketch=1;curveFitting=1;jiggle=2;html=1;strokeWidth=4;endArrow=classic;endSize=14;fontFamily=Comic Sans MS;fontSize=22;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.25;exitY=1;" edge="1" parent="lab03-1" source="lab03-c6" target="lab03-c7">
